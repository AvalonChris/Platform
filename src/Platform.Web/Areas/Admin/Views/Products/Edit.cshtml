@model ProductEditViewModel
@{
    ViewData["Title"] = Model.IsNew ? "New product" : Model.Form.Name;
}

<div class="head">
    <h1>@ViewData["Title"]</h1>
    <a asp-action="Index">Back to products</a>
</div>

<form class="form" asp-action="@(Model.IsNew ? "Create" : "Update")" asp-route-id="@(Model.IsNew ? null : Model.Form.Id)" method="post">
    <div class="field">
        <label asp-for="Form.Name">Name</label>
        <input asp-for="Form.Name" required />
        <span class="error" asp-validation-for="Form.Name"></span>
    </div>

    <div class="row">
        <div class="field">
            <label asp-for="Form.Slug">URL slug</label>
            <input asp-for="Form.Slug" required />
            <span class="hint">The product's address: /products/<em>slug</em></span>
            <span class="error" asp-validation-for="Form.Slug"></span>
        </div>
        <div class="field">
            <label asp-for="Form.Sku">SKU</label>
            <input asp-for="Form.Sku" required />
            <span class="error" asp-validation-for="Form.Sku"></span>
        </div>
        <div class="field">
            <label asp-for="Form.Kind">Kind</label>
            @if (Model.IsNew)
            {
                <select asp-for="Form.Kind">
                    <option value="@Product.KindSingle">Single supplement</option>
                    <option value="@Product.KindStack">Stack</option>
                </select>
                <span class="hint">Can't be changed later.</span>
            }
            else
            {
                <input value="@(Model.Form.IsStack ? "Stack" : "Single supplement")" disabled />
            }
            <span class="error" asp-validation-for="Form.Kind"></span>
        </div>
    </div>

    <div class="field">
        <label asp-for="Form.ShortSpec">Short spec</label>
        <input asp-for="Form.ShortSpec" />
        <span class="hint">Shown under the name, for example "500 mg · 60 capsules".</span>
        <span class="error" asp-validation-for="Form.ShortSpec"></span>
    </div>

    <div class="field">
        <label asp-for="Form.Description">Description</label>
        <textarea asp-for="Form.Description" rows="5"></textarea>
    </div>

    <div class="field">
        <label asp-for="Form.Ingredients">Ingredients</label>
        <textarea asp-for="Form.Ingredients" rows="3"></textarea>
        <span class="hint">As on the label, for example "β-Nicotinamide Mononucleotide (500 mg), HPMC (vegetable capsule), …". Leave blank for stacks; their pages link to each product.</span>
    </div>

    <div class="field">
        <label asp-for="Form.SuggestedUse">Suggested use</label>
        <textarea asp-for="Form.SuggestedUse" rows="3"></textarea>
    </div>

    <div class="field">
        <label asp-for="Form.Warnings">Warnings</label>
        <textarea asp-for="Form.Warnings" rows="3"></textarea>
    </div>

    <div class="row">
        <div class="field">
            <label asp-for="Form.Price">Price (USD)</label>
            <input asp-for="Form.Price" type="number" step="0.01" min="0" required />
            <span class="error" asp-validation-for="Form.Price"></span>
        </div>
        <div class="field">
            <label asp-for="Form.StockQuantity">Stock</label>
            <input asp-for="Form.StockQuantity" type="number" min="0" />
            <span class="error" asp-validation-for="Form.StockQuantity"></span>
        </div>
        <div class="field">
            <label asp-for="Form.SortOrder">Sort order</label>
            <input asp-for="Form.SortOrder" type="number" />
            <span class="hint">Lower numbers come first.</span>
        </div>
    </div>

    <div class="field">
        <label asp-for="Form.ImageUrl">Image URL</label>
        <input asp-for="Form.ImageUrl" />
        <span class="error" asp-validation-for="Form.ImageUrl"></span>
    </div>

    @if (!Model.Form.IsStack)
    {
        <fieldset>
            <legend>Supplier costs</legend>
            <span class="hint">
                Used by the profit report. Check them against Supliful from time to time.
                @(Model.Form.CostsUpdatedAt is null ? "Not set yet." : $"Last changed {AdminFormat.DateTime(Model.Form.CostsUpdatedAt)}.")
                @(Model.IsNew ? " Not used for stacks, which take their costs from their contents." : "")
            </span>
            <div class="row">
                <div class="field">
                    <label asp-for="Form.SupplierCost">Supplier cost per unit (USD)</label>
                    <input asp-for="Form.SupplierCost" type="number" step="0.01" min="0" />
                    <span class="hint">Supliful's on-demand price for your plan and volume tier.</span>
                    <span class="error" asp-validation-for="Form.SupplierCost"></span>
                </div>
                <div class="field">
                    <label asp-for="Form.ShippingWeightLb">Shipping weight (lb)</label>
                    <input asp-for="Form.ShippingWeightLb" type="number" step="0.001" min="0" />
                    <span class="hint">Gross weight from the product page.</span>
                    <span class="error" asp-validation-for="Form.ShippingWeightLb"></span>
                </div>
            </div>
        </fieldset>

        <div class="field">
            <label asp-for="Form.FulfillmentVariantId">Fulfilment variant ID (Shopify)</label>
            <input asp-for="Form.FulfillmentVariantId" />
            <span class="hint">The Shopify variant ID of the matching Supliful product. Orders containing this product can't be sent for fulfilment without it.@(Model.IsNew ? " Not used for stacks, which ship as their contents." : "")</span>
            <span class="error" asp-validation-for="Form.FulfillmentVariantId"></span>
        </div>
    }

    <fieldset>
        <legend>Visibility</legend>
        <label class="check"><input asp-for="Form.IsActive" /> Active (visible in the store)</label>
        <label class="check"><input asp-for="Form.IsFeatured" /> Featured on the home page</label>
        <label class="check"><input asp-for="Form.IsNew" /> Shown under New on the home page</label>
    </fieldset>

    @if (Model.IsNew || Model.Form.IsStack)
    {
        <fieldset>
            <legend>Stack contents</legend>
            @if (Model.IsNew)
            {
                <span class="hint">Only used when the kind is Stack.</span>
            }
            <span class="hint">How many of each product the stack contains. Leave at 0 to leave it out.</span>
            @foreach (var single in Model.Singles)
            {
                <label class="check">
                    <input class="qty" type="number" name="Form.ComponentQuantities[@single.Id]" value="@Model.Form.QuantityOf(single.Id)" min="0" max="@ProductForm.MaxComponentQuantity" aria-label="Quantity of @single.Name" />
                    @single.Name
                </label>
            }
            <span class="error" asp-validation-for="Form.ComponentQuantities"></span>
        </fieldset>
    }

    <div><button class="primary" type="submit">@(Model.IsNew ? "Create product" : "Save changes")</button></div>
</form>
