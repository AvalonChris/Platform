@model IReadOnlyList<Platform.Web.Data.WebhookEventRow>
@{
    ViewData["Title"] = "Webhooks";
}

<div class="head">
    <h1>PayPal webhooks</h1>
</div>

<p class="hint">The last 100 notifications from PayPal. Events the store doesn't act on are recorded and ignored.</p>

@if (Model.Count == 0)
{
    <p>None received yet.</p>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>Received</th><th>Event</th><th>PayPal resource</th><th>Result</th></tr>
            </thead>
            <tbody>
                @foreach (var webhook in Model)
                {
                    <tr>
                        <td>@AdminFormat.DateTime(webhook.ReceivedAt)</td>
                        <td>@webhook.EventType</td>
                        <td>@webhook.ResourceId</td>
                        <td>
                            @if (webhook.ProcessedAt is not null)
                            {
                                <span class="tag">Processed</span>
                            }
                            else if (webhook.Error is not null)
                            {
                                <span class="error">Failed: @webhook.Error</span>
                            }
                            else
                            {
                                <span class="tag">Pending</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
