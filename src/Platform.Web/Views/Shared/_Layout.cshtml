@inject Microsoft.Extensions.Options.IOptions<StoreOptions> Options
@{
    var brand = Options.Value.BrandName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} · {brand}" : brand)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header-row">
            <nav aria-label="Main" class="site-nav">
                <a asp-controller="Shop" asp-action="Index">Shop</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-kind="@Product.KindStack">Stacks</a>
            </nav>
            <a class="site-logo" asp-controller="Home" asp-action="Index">@brand</a>
            <div class="site-header-end">@await Component.InvokeAsync("CartLink")</div>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-brand">@brand</div>
            <p>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
        </div>
    </footer>
</body>
</html>
