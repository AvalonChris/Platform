@inject Microsoft.Extensions.Options.IOptions<StoreOptions> Options
@{
    var brand = Options.Value.BrandName;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string title ? $"{title} · {brand}" : brand)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container site-header-row">
            <nav aria-label="Main" class="site-nav">
                <a asp-controller="Shop" asp-action="Index">Shop</a>
                <a asp-controller="Shop" asp-action="Index" asp-route-kind="@Product.KindStack">Stacks</a>
            </nav>
            <a class="site-logo" asp-controller="Home" asp-action="Index" aria-label="@brand home">
                <span class="wordmark">@brand.ToLowerInvariant()<span class="wordmark-cursor" aria-hidden="true"></span></span>
            </a>
            <div class="site-header-end">
                <a class="account-link" asp-controller="Account" asp-action="Index">Account</a>
                @await Component.InvokeAsync("CartLink")
            </div>
        </div>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="site-footer-brand">
                <span class="wordmark">@brand.ToLowerInvariant()<span class="wordmark-cursor" aria-hidden="true"></span></span>
            </div>
            <nav aria-label="Policies" class="site-footer-links">
                <a asp-controller="Pages" asp-action="ShippingAndRefunds">Shipping &amp; refunds</a>
                <a asp-controller="Pages" asp-action="SubscriptionTerms">Subscription terms</a>
                <a asp-controller="Pages" asp-action="Privacy">Privacy</a>
                <a asp-controller="Pages" asp-action="Terms">Terms</a>
                <a asp-controller="Pages" asp-action="Contact">Contact</a>
            </nav>
            <p>These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
            <p>© @DateTime.UtcNow.Year @Options.Value.LegalName · @Options.Value.ContactEmail</p>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
