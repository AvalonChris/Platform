@model string
@{
    ViewData["Title"] = "Sign in";
}

<section class="section account-narrow">
    <h1>Sign in</h1>
    <p class="muted">Continue to your account.</p>
    <form asp-action="CompleteSignIn" asp-route-token="@Model" method="post">
        <button class="button" type="submit">Sign in</button>
    </form>
</section>
